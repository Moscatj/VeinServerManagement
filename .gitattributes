# Default: normalize text to LF in the repo
*               text=auto eol=lf

# Windows batch files need CRLF to run when double-clicked
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Shell/PowerShell scripts stay LF (cross-platform, CI friendly)
*.sh            text eol=lf
*.ps1           text eol=lf

# Project text files (LF)
*.py            text eol=lf
*.json          text eol=lf
*.ini           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# Binary files — never normalize
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.7z            binary
*.exe           binary
*.dll           binary
*.pdb           binary
*.vns           binary
