# ===== Vein Server Management =====
# Transient runtime state
Runtime/
!Runtime/.gitkeep         # keep folder structure placeholder if needed

# Logs (server and monitor output)
Logs/
Vein/Saved/Logs/
!Logs/.gitkeep

# Backups (can be huge; exclude all for now)
Backups/
!Backups/.gitkeep

# ===== Python build & cache files =====
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ===== Virtual environments =====
.venv/
venv/
env/
ENV/
Scripts/__pycache__/

# ===== Windows & editor artifacts =====
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk
*.bak
*.tmp
*.swp
*.log

# ===== Git and IDE junk =====
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# ===== Optional: compiled executables and test outputs =====
*.exe
*.bat~
*.old
.coverage
htmlcov/

# API keys / local secrets
.env
.env.*
!.env.example

# Continue local config/secrets
.continue/.env
.continue/**/*.env

.continue/.env
.env
